# Copy this file to .env. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL / MariaDB database settings
MYSQL_DATABASE=mcq_exam_db
MYSQL_USER=mcq_exam_user
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
